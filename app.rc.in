#pragma code_page(65001)
#include <windows.h>

#define APP_VERSION_STR "@APP_VERSION_STR@"
#define APP_VERSION_NUM @APP_VERSION_NUM@

IDI_ICON1 ICON DISCARDABLE "icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "易触控\0"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "ProductName", "易触控\0"
            VALUE "ProductVersion", APP_VERSION_STR
            VALUE "LegalCopyright", "© 2026 jin-ct\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
